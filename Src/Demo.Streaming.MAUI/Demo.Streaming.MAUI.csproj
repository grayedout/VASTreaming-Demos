<Project>

  <Import Project="..\Common\Common.MAUI.props" />
  <Import Project="Sdk.props" Sdk="Microsoft.NET.Sdk" />

  <!-- Microsoft.Maui.Controls reference must be in the beginning, otherwise .NET 10 compilation fails -->
  <ItemGroup>
    <PackageReference Include="System.IO.Packaging" Version="10.0.1" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('net9.0'))">
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.120" />
    <PackageReference Include="Microsoft.Maui.Graphics.Skia" Version="9.0.120" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('net10.0'))">
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.20" />
    <PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.20" />
    <PackageReference Include="Microsoft.Maui.Graphics.Skia" Version="10.0.20" />
  </ItemGroup>

  <!-- Microsoft.Windows.Compatibility is necessary for PerformanceCounter to collect GPU stat on Windows and for image encoders -->
  <ItemGroup Condition="$(TargetFramework.Contains('net8.0')) Or $(TargetFramework.Contains('net9.0'))">
    <!-- v8.0 must be used for .NET 9 because System.Drawing.Imaging.ImageCodecInfo.GetImageEncoders is broken in v9.0 -->
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('net10.0'))">
    <PackageReference Include="Microsoft.Windows.Compatibility" Version="10.0.1" />
  </ItemGroup>

  <PropertyGroup>

    <TargetFrameworks Condition="$(VastMauiPlatforms.Contains('android')) == 'True'">$(VastNetCoreTargets)-android</TargetFrameworks>
    <TargetFrameworks Condition="$(VastMauiPlatforms.Contains('ios')) == 'True'">$(TargetFrameworks);$(VastNetCoreTargets)-ios</TargetFrameworks>
    <TargetFrameworks Condition="$(VastMauiPlatforms.Contains('maccatalyst')) == 'True'">$(TargetFrameworks);$(VastNetCoreTargets)-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$(VastMauiPlatforms.Contains('windows')) == 'True' AND $([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);$(VastNetCoreTargets)-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>VAST.Demo</RootNamespace>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <UseMaui>true</UseMaui>
    <EnableSourceControlManagerQueries>false</EnableSourceControlManagerQueries>
    <SkipValidateMauiImplicitPackageReferences>true</SkipValidateMauiImplicitPackageReferences>

    <!-- Display name -->
    <ApplicationTitle>VAST.Demo.Streaming</ApplicationTitle>
    <AssemblyName>VAST.Demo.Streaming</AssemblyName>

    <!-- App Identifier -->
    <ApplicationId>com.vastreaming.demo.streaming</ApplicationId>
    <ApplicationIdGuid>CCAC1E2C-F161-4577-8DC5-9667D6AB329A</ApplicationIdGuid>

    <!-- Versions -->
    <ApplicationDisplayVersion>2024.5.6</ApplicationDisplayVersion>
    <ApplicationVersion>7</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('ios')) == 'True' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">12.2</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('maccatalyst')) == 'True' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">12.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('android')) == 'True' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$(TargetFramework.Contains('windows')) == 'True' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$(TargetFramework.Contains('windows')) == 'True' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

  </PropertyGroup>

  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
