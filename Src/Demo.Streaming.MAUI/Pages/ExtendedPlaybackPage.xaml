<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="VAST.Demo.ExtendedPlaybackPage"
             xmlns:vast="clr-namespace:VAST.Controls;assembly=VAST.UI"
             Title="Extended Playback"
             NavigatingFrom="ContentPage_NavigatingFrom">

    <Grid>
        <vast:MediaPlayerControl x:Name="player" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand" BackgroundColor="Black" />

        <StackLayout Orientation="Horizontal" VerticalOptions="Start" HorizontalOptions="Start" Spacing="5" Margin="10,10,0,0">
            <Button x:Name="btnControls" Text="Controls" WidthRequest="100" Clicked="btnControls_Clicked" />
            <Button x:Name="btnOnvif" Text="ONVIF" WidthRequest="100" IsVisible="False" Clicked="btnOnvif_Clicked" />
        </StackLayout>
        <Button x:Name="btnEmailLog" Text="Send Log" VerticalOptions="Start" HorizontalOptions="End" WidthRequest="100" Margin="0,10,10,0" Clicked="btnSendLog_Clicked" />

        <BoxView x:Name="panelDismissLayer" IsVisible="False" Color="Transparent" InputTransparent="False" VerticalOptions="FillAndExpand" HorizontalOptions="FillAndExpand">
            <BoxView.GestureRecognizers>
                <TapGestureRecognizer Tapped="dismissPanel_Tapped" />
            </BoxView.GestureRecognizers>
        </BoxView>

        <ScrollView x:Name="controlsPanel" IsVisible="False" VerticalOptions="Start" HorizontalOptions="Start" MaximumWidthRequest="500" BackgroundColor="#CC222222" Padding="10" Margin="0,50,0,0">
            <VerticalStackLayout Spacing="5">

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                    <Label Text="URI" FontSize="Small" VerticalTextAlignment="Center" TextColor="White" Grid.Column="0" />
                    <Entry x:Name="tboxUri" FontSize="Small" Text="" TextColor="White" Grid.Column="1" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                    <Label Text="Video" FontSize="Small" VerticalTextAlignment="Center" TextColor="White" Grid.Column="0" />
                    <Picker x:Name="pickerVideoTrack" FontSize="Small" HorizontalOptions="FillAndExpand" IsEnabled="False" Grid.Column="1" SelectedIndexChanged="pickerVideoTrack_SelectedIndexChanged" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                    <Label Text="Audio" FontSize="Small" VerticalTextAlignment="Center" TextColor="White" Grid.Column="0" />
                    <Picker x:Name="pickerAudioTrack" FontSize="Small" HorizontalOptions="FillAndExpand" IsEnabled="False" Grid.Column="1" SelectedIndexChanged="pickerAudioTrack_SelectedIndexChanged" />
                </Grid>

                <StackLayout Orientation="Horizontal" Spacing="5">
                    <Button x:Name="btnStart" Text="Play" WidthRequest="80" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" Clicked="btnPlay_Clicked" />
                    <Button x:Name="btnStop" Text="Stop" WidthRequest="80" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" Clicked="btnStop_Clicked" />
                </StackLayout>

                <StackLayout Orientation="Horizontal" Spacing="5">
                    <Button x:Name="btnPause" IsEnabled="False" Text="Pause" WidthRequest="80" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" Clicked="btnPause_Click" />
                    <Button x:Name="btnRewind" Text="&lt;&lt;&lt;" IsEnabled="False" WidthRequest="60" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" Clicked="btnRewind_Clicked" />
                    <Button x:Name="btnFastForward" Text="&gt;&gt;&gt;" IsEnabled="False" WidthRequest="60" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" Clicked="btnFastForward_Clicked" />
                </StackLayout>

                <Slider x:Name="sliderPosition" IsEnabled="False" DragStarted="sliderPosition_DragStarted" DragCompleted="sliderPosition_DragCompleted" ValueChanged="sliderPosition_ValueChanged" />

                <Label x:Name="labelPosition" Text="0:00:00.000" FontSize="Small" TextColor="White" />

                <StackLayout Orientation="Horizontal" Spacing="5">
                    <Button x:Name="btnStartRecord" Text="Record" WidthRequest="80" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" Clicked="btnStartRecord_Click" />
                    <Button x:Name="btnStopRecord" Text="Stop Rec" WidthRequest="100" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" Clicked="btnStopRecord_Click" />
                    <Button x:Name="btnSnapshot" Text="Snapshot" WidthRequest="100" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" Clicked="btnTakeSnapshot_Click" />
                </StackLayout>

                <BoxView HeightRequest="1" Color="#55FFFFFF" Margin="0,5,0,5" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                    <Label Text="Rendering" FontSize="Small" VerticalTextAlignment="Center" TextColor="White" Grid.Column="0" />
                    <Picker x:Name="pickerRenderingStrategy" FontSize="Small" HorizontalOptions="FillAndExpand" SelectedIndex="0" Grid.Column="1">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Low Latency</x:String>
                                <x:String>Smooth</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                    <Label Text="Decoder" FontSize="Small" VerticalTextAlignment="Center" TextColor="White" Grid.Column="0" />
                    <Picker x:Name="pickerDecoder" FontSize="Small" HorizontalOptions="FillAndExpand" SelectedIndex="0" Grid.Column="1">
                        <Picker.ItemsSource>
                            <x:Array Type="{x:Type x:String}">
                                <x:String>Builtin</x:String>
                                <x:String>FFmpeg</x:String>
                            </x:Array>
                        </Picker.ItemsSource>
                    </Picker>
                </Grid>

                <VerticalStackLayout x:Name="layoutWindowsControls" Spacing="5">
                    <StackLayout Orientation="Horizontal">
                        <CheckBox x:Name="checkBoxHardwareAcceleration" IsChecked="True" VerticalOptions="Center" />
                        <Label Text="Hardware Acceleration" FontSize="Small" VerticalTextAlignment="Center" TextColor="White" />
                    </StackLayout>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                        <Label Text="Renderer" FontSize="Small" VerticalTextAlignment="Center" TextColor="White" Grid.Column="0" />
                        <Picker x:Name="pickerVideoRenderer" FontSize="Small" HorizontalOptions="FillAndExpand" SelectedIndex="0" Grid.Column="1">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>Auto</x:String>
                                    <x:String>Best</x:String>
                                    <x:String>Compatible</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                        <Label Text="Audio Device" FontSize="Small" VerticalTextAlignment="Center" TextColor="White" Grid.Column="0" />
                        <Picker x:Name="pickerAudioDevice" FontSize="Small" HorizontalOptions="FillAndExpand" SelectedIndex="0" Grid.Column="1" />
                    </Grid>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <ScrollView x:Name="onvifPanel" IsVisible="False" VerticalOptions="Start" HorizontalOptions="Start" MaximumWidthRequest="500" BackgroundColor="#CC222222" Padding="10" Margin="0,50,0,0">
            <VerticalStackLayout Spacing="5">

                <Button x:Name="btnDiscover" Text="Discover Devices" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                    <Label Text="Device" FontSize="Small" VerticalTextAlignment="Center" TextColor="White" Grid.Column="0" />
                    <Picker x:Name="pickerOnvifDevice" FontSize="Small" HorizontalOptions="FillAndExpand" Grid.Column="1" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                    <Label Text="Username" FontSize="Small" VerticalTextAlignment="Center" TextColor="White" Grid.Column="0" />
                    <Entry x:Name="txtOnvifUsername" FontSize="Small" TextColor="White" Grid.Column="1" />
                </Grid>

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                    <Label Text="Password" FontSize="Small" VerticalTextAlignment="Center" TextColor="White" Grid.Column="0" />
                    <Entry x:Name="txtOnvifPassword" FontSize="Small" TextColor="White" IsPassword="True" Grid.Column="1" />
                </Grid>

                <Button x:Name="btnScanOnvif" Text="Scan ONVIF Services" IsEnabled="False" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5">
                    <Label Text="URI" FontSize="Small" VerticalTextAlignment="Center" TextColor="White" Grid.Column="0" />
                    <Picker x:Name="pickerOnvifUri" FontSize="Small" HorizontalOptions="FillAndExpand" Grid.Column="1" />
                </Grid>

                <Button x:Name="btnPlayOnvifUri" Text="Play URI" IsEnabled="False" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" />

                <Label x:Name="lblOnvifState" Text="Press Discover to scan ONVIF devices" FontSize="Small" TextColor="#AAAAAA" />

                <BoxView HeightRequest="1" Color="#55FFFFFF" Margin="0,5,0,5" />

                <VerticalStackLayout x:Name="layoutPtzControls" IsVisible="False" Spacing="5">

                    <Label Text="PTZ Controls" FontSize="Small" TextColor="White" FontAttributes="Bold" />

                    <StackLayout Orientation="Horizontal" Spacing="5" HorizontalOptions="Center">
                        <Button x:Name="btnZoomIn" Text="Zoom In" WidthRequest="100" IsEnabled="False" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" />
                        <Button x:Name="btnZoomOut" Text="Zoom Out" WidthRequest="100" IsEnabled="False" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" />
                    </StackLayout>

                    <StackLayout Orientation="Horizontal" Spacing="5" HorizontalOptions="Center">
                        <Button x:Name="btnMoveUp" Text="Up" WidthRequest="100" IsEnabled="False" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" />
                    </StackLayout>

                    <StackLayout Orientation="Horizontal" Spacing="5" HorizontalOptions="Center">
                        <Button x:Name="btnMoveLeft" Text="Left" WidthRequest="100" IsEnabled="False" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" />
                        <Button x:Name="btnMoveRight" Text="Right" WidthRequest="100" IsEnabled="False" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" />
                    </StackLayout>

                    <StackLayout Orientation="Horizontal" Spacing="5" HorizontalOptions="Center">
                        <Button x:Name="btnMoveDown" Text="Down" WidthRequest="100" IsEnabled="False" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" />
                    </StackLayout>

                    <BoxView HeightRequest="1" Color="#55FFFFFF" Margin="0,2,0,2" />

                    <Grid ColumnDefinitions="Auto,Auto,Auto" ColumnSpacing="5">
                        <Label Text="Home" FontSize="Small" VerticalTextAlignment="Center" TextColor="White" Grid.Column="0" />
                        <Button x:Name="btnSaveHome" Text="Store" WidthRequest="80" IsEnabled="False" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" Grid.Column="1" />
                        <Button x:Name="btnRecallHome" Text="Recall" WidthRequest="80" IsEnabled="False" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" Grid.Column="2" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,60,Auto,Auto" ColumnSpacing="5">
                        <Label Text="Preset #" FontSize="Small" VerticalTextAlignment="Center" TextColor="White" Grid.Column="0" />
                        <Entry x:Name="txtPresetNumber" Text="0" Keyboard="Numeric" FontSize="Small" TextColor="White" Grid.Column="1" />
                        <Button x:Name="btnSavePreset" Text="Store" WidthRequest="80" IsEnabled="False" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" Grid.Column="2" />
                        <Button x:Name="btnRecallPreset" Text="Recall" WidthRequest="80" IsEnabled="False" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" Grid.Column="3" />
                    </Grid>

                    <Button x:Name="btnOnvifSnapshot" Text="Take Snapshot" IsEnabled="False" HeightRequest="{Binding Source={x:Reference btnControls}, Path=Height}" />

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
